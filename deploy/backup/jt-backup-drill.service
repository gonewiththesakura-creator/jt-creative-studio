[Unit]
Description=Monthly JT restore drill from the offsite restic repository
After=network-online.target
Wants=network-online.target
OnFailure=jt-backup-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/jt-backup/backup.env
Environment=RESTIC_CACHE_DIR=/var/cache/jt-backup
# Restores only into this unit's private /tmp, which systemd discards afterwards.
Environment=TMPDIR=/tmp
ExecStart=/usr/bin/python3 /usr/local/libexec/jt-backup/jt_restore_drill.py --restic latest --report /var/backups/jt/drill-report.json
TimeoutStartSec=4h
UMask=0077
Nice=15
IOSchedulingClass=idle
CacheDirectory=jt-backup
CacheDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# Production data stays invisible to the drill.
ProtectHome=yes
InaccessiblePaths=/opt/jt-identity
ReadWritePaths=/var/backups/jt
