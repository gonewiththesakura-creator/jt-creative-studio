# Copy to /etc/jt-backup/backup.env on the server (root:root, mode 0600).
# This example holds placeholders only; real values never go into Git.

# Sources and local snapshot root
JT_BACKUP_PANEL_DIR=/home/admin/comfy-panel/panel_data
JT_BACKUP_IDENTITY_DIR=/opt/jt-identity/data
JT_BACKUP_ROOT=/var/backups/jt
# Private config captured into the encrypted snapshot (colon separated).
JT_BACKUP_EXTRA_PATHS=/opt/jt-identity/compose.yaml:/opt/jt-identity/conf:/opt/jt-identity/panel-membership.env:/etc/comfy-panel:/etc/systemd/system/comfy-panel.service:/etc/systemd/system/comfy-panel.service.d
JT_BACKUP_HOST_TAG=jt-prod

# Retention (local snapshots and restic forget use the same rule)
JT_BACKUP_KEEP_DAILY=7
JT_BACKUP_KEEP_WEEKLY=4
JT_BACKUP_KEEP_MONTHLY=3
JT_BACKUP_MIN_FREE_MB=2048

# Consistency: bracket retries, then optional cgroup freeze of the panel
JT_BACKUP_BRACKET_ATTEMPTS=20
JT_BACKUP_FREEZE_UNIT=comfy-panel.service

# Offsite (restic). Choose ONE repository form; see docs/backup-operations.md.
JT_BACKUP_OFFSITE=restic
RESTIC_PASSWORD_FILE=/etc/jt-backup/restic-password
# Option A, S3-compatible object storage:
# RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/jt-panel
# AWS_ACCESS_KEY_ID=<bucket-scoped key id>
# AWS_SECRET_ACCESS_KEY=<bucket-scoped secret>
# Option B, append-only rest-server on a second machine you control:
# RESTIC_REPOSITORY_FILE=/etc/jt-backup/restic-repository
# JT_BACKUP_RESTIC_PRUNE=0
JT_BACKUP_RESTIC_PRUNE=1

# Alerts (any subset). Webhook URLs contain tokens: keep them only here.
# JT_BACKUP_ALERT_WEBHOOK=<robot webhook url>
# JT_BACKUP_ALERT_FORMAT=wecom
# JT_BACKUP_ALERT_EMAIL=<ops mailbox>
# Dead-man switch, e.g. a healthchecks.io check URL (pinged on success, /fail on failure)
# JT_BACKUP_HEARTBEAT_URL=<check url>
